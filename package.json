{
  "name": "annotinder",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k --kill-signal SIGTERM -p \"[{name}]\" -n \"mock,client\" -c \"blue,green\" \"pnpm --filter @annotinder/mock-server dev\" \"pnpm --filter @annotinder/client dev\"",
    "dev:client": "pnpm --filter @annotinder/client run dev",
    "dev:mock-server": "pnpm --filter @annotinder/mock-server run dev",
    "reset-mock": "pnpm --filter @annotinder/mock-server run db:reset",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.4.2",
    "typescript": "5.7.2"
  }
}
