{
  "name": "annotinder",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "pnpm --filter @annotinder/contracts build",
    "dev": "concurrently -k --kill-signal SIGTERM -p \"[{name}]\" -n \"contracts,server,client\" -c \"magenta,blue,green\" \"pnpm --filter @annotinder/contracts dev\" \"pnpm --filter @annotinder/server dev\" \"pnpm --filter @annotinder/client dev\"",
    "dev:contracts": "pnpm --filter @annotinder/contracts run dev",
    "dev:client": "pnpm --filter @annotinder/contracts build && pnpm --filter @annotinder/client run dev",
    "dev:server": "pnpm --filter @annotinder/contracts build && pnpm --filter @annotinder/server run dev",
    "reset-db": "pnpm --filter @annotinder/server run db:reset",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.4.2",
    "typescript": "5.7.2"
  }
}
