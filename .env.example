# Settings for docker-compose.yml (docs/hosting.md). Copy to `.env`.

# Where browsers reach AnnoTinder (no trailing slash). The login provider
# redirects to <ANNOTINDER_PUBLIC_URL>/auth/callback.
ANNOTINDER_PUBLIC_URL=https://annotinder.example.org
# Only for the `tls` profile (Caddy): the domain to get a certificate for.
ANNOTINDER_DOMAIN=annotinder.example.org

# Signs login state and preview links. A long random string, e.g. `openssl rand -base64 48`.
ANNOTINDER_SECRET=

# The database password (the compose file builds DATABASE_URL from it).
POSTGRES_PASSWORD=

# Researcher login: an OpenID Connect provider. Register AnnoTinder there as
# a confidential client with the redirect URI above; it must return verified
# email addresses (scope "openid email").
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# The server's first admins (comma-separated emails): they get the admin role on login.
ANNOTINDER_ADMINS=

# Researchers need a login with a second factor (as the provider reports it). Recommended.
ANNOTINDER_REQUIRE_MFA=1
