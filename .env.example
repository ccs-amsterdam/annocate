# AnnoTinder settings for compose.yml (docs/hosting.md, "Settings"). Copy to
# `.env`, fill in the required ones, and keep it readable only by its owner
# (chmod 600): it holds secrets. Never commit it.
# Generate secrets with `openssl rand -hex 32`: hex needs no quoting or escaping.

# --- Required ---------------------------------------------------------------

# Where browsers reach AnnoTinder: https://, no trailing slash. The login
# callback is <ANNOTINDER_PUBLIC_URL>/api/auth/callback.
ANNOTINDER_PUBLIC_URL=https://annotinder.example.org

# Signs login state and preview links: a long random string (openssl rand -hex
# 32). Changing it ends logins in progress and invalidates preview links.
ANNOTINDER_SECRET=

# The database password; compose.yml builds DATABASE_URL from it, so only
# letters and digits: openssl rand -hex 32. Set it before the first start:
# the database keeps the password it was created with.
POSTGRES_PASSWORD=

# Researcher login, an OpenID Connect provider (docs/hosting.md, "The login
# client"): the issuer, and the confidential client registered there with the
# redirect URI above. The lab's provider: https://auth.societal-analytics.nl/realms/idp
OIDC_HOST=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# The provider's account page, where users set up a second factor (AnnoTinder
# links to it). Required unless AUTH_INSECURE_DISABLE_2FA. Keycloak:
# <OIDC_HOST>/account
OIDC_ACCOUNT_URL=

# The server's first admins: comma-separated email addresses that get the
# admin role when they log in (with a verified address).
ANNOTINDER_ADMINS=

# The release this server runs: compose.yml pulls its published image
# (ghcr.io/ccs-amsterdam/annotinder). Check out the same release's tag
# (git checkout v0.9.0), so compose.yml and this file match it.
ANNOTINDER_VERSION=0.9.0

# --- Optional ---------------------------------------------------------------

# The "About this server" page (/about, linked from the start page): who runs
# this server, where it is hosted (in your own words: the VM, the database,
# the backups, a proxy in front), how to reach you (an email address or other
# text), and the web addresses of its privacy statement and terms of use.
# What you leave out, the page shows as "Not stated".
# ANNOTINDER_OPERATOR=
# ANNOTINDER_HOSTING=
# ANNOTINDER_CONTACT=
# ANNOTINDER_PRIVACY_URL=
# ANNOTINDER_TERMS_URL=

# Which ID token claim counts as a second factor: amr:mfa (default; the lab's
# Keycloak) or acr:<value> (e.g. SURFconext).
# OIDC_MFA_CLAIM=amr:mfa

# Weaker security: only for teaching and other servers without sensitive data
# (docs/security.md §1, "Weaker security"). AUTH_INSECURE_DISABLE_2FA: for a
# provider without a usable 2FA signal (e.g. a free Auth0 tenant);
# AUTH_INSECURE_DISABLE_EMAIL_VERIFICATION: for a provider that verifies
# addresses but doesn't send email_verified.
# AUTH_INSECURE_DISABLE_2FA=true
# AUTH_INSECURE_DISABLE_EMAIL_VERIFICATION=true

# How many seconds a second factor stays fresh for sensitive actions (API
# keys, admin changes) before a step-up login. Default 600.
# AUTH_STEP_UP_MAX_AGE=600

# Origins (space or comma separated) that may show AnnoTinder in a frame,
# e.g. AmCAT: https://amcat.example.org
# ANNOTINDER_FRAME_ANCESTORS=

# Database connections of the server process. Default 20.
# PGPOOL_MAX=20

# `off`: no rate limits, only for a load test from one machine.
# ANNOTINDER_RATE_LIMITS=off

# While moving to another login provider (docs/accounts.md, "Changing
# providers"): the previous one, accepted until OIDC_PREVIOUS_UNTIL (a date),
# so users can link their new login.
# OIDC_PREVIOUS_HOST=
# OIDC_PREVIOUS_CLIENT_ID=
# OIDC_PREVIOUS_CLIENT_SECRET=
# OIDC_PREVIOUS_MFA_CLAIM=amr:mfa
# OIDC_PREVIOUS_UNTIL=2027-03-01

# Behind the Cloudflare proxy: take the client address from CF-Connecting-IP.
# compose.yml sets `proxy` (X-Forwarded-For from the proxy on this machine).
# ANNOTINDER_TRUST_PROXY=cloudflare

# New coding sessions per client address per 10 minutes (a university network
# shares one address, so keep it high), or `off`.
# ANNOTINDER_NEW_SESSIONS_PER_ADDRESS=500

# Set by compose.yml or the image, not here: DATABASE_URL, PORT, ANNOTINDER_CLIENT_DIR, and the build argument ANNOTINDER_COMMIT (given
# on the command line when building). Development only, never on a server:
# AUTH_DEV_MODE, ANNOTINDER_DEMO, PGLITE_DIR.
