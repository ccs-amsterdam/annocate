{
  "job": { "name": "Conformance job" },
  "codebook": {
    "items": [
      {
        "type": "question",
        "name": "group",
        "variable": { "type": "auto", "source": "invite", "options": [{ "code": "a" }, { "code": "b" }] }
      },
      {
        "type": "unit_loop",
        "name": "main",
        "layout": { "template": "{{$unit.text}}" },
        "units": [{ "sources": [{ "unitset": "first_half" }, { "unitset": "second_half" }] }],
        "children": [
          {
            "type": "question",
            "name": "q1",
            "variable": { "type": "select_code", "question": "Q1?", "codes": [{ "code": "yes" }, { "code": "no" }] }
          },
          {
            "type": "question",
            "name": "q2",
            "variable": { "type": "select_code", "question": "Q2?", "codes": [{ "code": "x" }, { "code": "y" }] }
          }
        ]
      }
    ]
  },
  "units": [
    { "externalId": "u1", "data": { "text": "first unit" } },
    { "externalId": "u2", "data": { "text": "second unit" } },
    { "externalId": "u3", "data": { "text": "third unit" } },
    { "externalId": "u4", "data": { "text": "fourth unit" } }
  ],
  "unitsets": [
    { "name": "first_half", "externalIds": ["u1", "u2"] },
    { "name": "second_half", "externalIds": ["u3", "u4"] }
  ],
  "invites": [
    { "secret": "conf-open", "label": "Open", "auth": "none" },
    { "secret": "conf-single", "label": "Single use", "auth": "none", "maxUses": 1 },
    { "secret": "conf-preset", "label": "Preset group", "auth": "none", "variables": { "group": "b" } },
    { "secret": "conf-url", "label": "Participant from URL", "auth": "none", "participantFromUrl": true, "maxUses": 1 },
    { "secret": "conf-fixed", "label": "Fixed participant", "auth": "none", "participantId": "P-fixed" },
    { "secret": "conf-login", "label": "Login required", "auth": "required" }
  ]
}
