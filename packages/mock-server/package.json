    "lint": "eslint .",
    "db:reset": "tsx src/db/reset.ts"
  },
  "dependencies": {
    "@annotinder/contracts": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "26.6.1",
    "eslint": "9.17.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
