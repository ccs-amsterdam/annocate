{
  "name": "@annotinder/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "examples"
  ],
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "start": "node dist/index.js",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "db:reset": "tsx src/reset.ts",
    "keys": "tsx src/keys.ts"
  },
  "dependencies": {
    "@annotinder/contracts": "workspace:*",
    "@electric-sql/pglite": "0.5.9",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.6.14",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.6.1",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^5.0.1"
  }
}
