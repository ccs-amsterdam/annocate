  "design": {
    "note": "Example: sentiment by swiping",
    "public": {
      "title": "Good news, bad news"
    },
    "session": {
      "invite": {
        "mode": "coders",
        "link": "per_coder"
      }
    },
    "items": [
      {
        "type": "unit_loop",
        "id": "loop_1",
        "label": "Headlines",
        "children": [
          {
            "type": "layout",
            "template": "# $unit.headline"
          },
          {
            "type": "question",
            "name": "sentiment",
            "variable": {
              "type": "swipe",
              "question": "Is this headline good news or bad news?",
              "options": [
                {
                  "value": "negative",
                  "label": "Bad news",
                  "color": "crimson"
                },
                {
                  "value": "positive",
                  "label": "Good news",
                  "color": "seagreen"
                },
                {
                  "value": "neutral",
                  "label": "Neither",
                  "color": "darkgray"
                }
              ]
            },
            "instruction": "Swipe right for good news, left for bad news, up if it is neither. The arrow keys work too."
          }
        ]
      }
    ]
  },
