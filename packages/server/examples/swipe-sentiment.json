  "codebook": {
    "note": "Example: sentiment by swiping",
    "items": [
      {
        "type": "unit_loop",
        "label": "Headlines",
        "units": [
          {
            "mode": "sets",
            "unitsets": [
              "part_1",
              "part_2",
              "part_3"
            ],
            "overlap": {
              "unitset": "overlap",
              "placement": "spread"
            }
          }
        ],
        "layout": {
          "template": "# $unit.headline"
        },
        "children": [
          {
            "type": "question",
            "name": "sentiment",
            "variable": {
              "type": "annotinder",
              "question": "Is this headline good news or bad news?",
              "instruction": "Swipe right for good news, left for bad news, up if it is neither. The arrow keys work too.",
              "options": [
                {
                  "value": "negative",
                  "label": "Bad news",
                  "color": "#ef4444"
                },
                {
                  "value": "positive",
                  "label": "Good news",
                  "color": "#22c55e"
                },
                {
                  "value": "neutral",
                  "label": "Neither",
                  "color": "#9ca3af"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "invites": [
    {
      "label": "Open link"
    }
  ],
