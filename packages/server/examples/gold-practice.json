  "design": {
    "note": "Example: practice and gold units",
    "public": {
      "title": "Sorting news headlines"
    },
    "session": {
      "invite": {
        "mode": "crowd"
      },
      "end": {
        "message": "Thank you! Your answers have been saved."
      }
    },
    "items": [
      {
        "type": "question",
        "name": "consent",
        "variable": {
          "type": "nominal",
          "question": "In this study you sort short local news headlines by topic and say whether they are clickbait. The headlines are made up for this example.\n\nYou start with **four practice headlines**: when an answer is wrong, you are told why and answer again. Some later headlines have a known answer, to check the quality of the work: if you get too many of those wrong, the study ends early.\n\nDo you want to take part?",
          "options": [
            {
              "value": "yes",
              "label": "Yes, start"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        }
      },
      {
        "type": "branch",
        "label": "Screen-out",
        "condition": {
          "script": "$var.consent.is('no')"
        },
        "children": [
          {
            "type": "end",
            "name": "screened_out",
            "outcome": "screenout",
            "message": "Thank you for your interest. This is where the study ends for you."
          }
        ]
      },
      {
        "type": "unit_loop",
        "id": "loop_1",
        "label": "Headlines",
        "units": {
          "divide": {
            "codersPerUnit": {
              "min": 2,
              "max": 2
            }
          },
          "practice": "before",
          "practiceCheck": {
            "questions": ["topic", "clickbait"]
          },
          "gold": "spread",
          "goldCheck": {
            "questions": ["topic"],
            "health": {
              "start": 2,
              "wrong": -1,
              "right": 1,
              "end": "screened_out"
            }
          }
        },
        "children": [
          {
            "type": "layout",
            "label": "The headline",
            "template": "::: if $unit.test_set === \"practice\"\n> **Practice headline.** If an answer is wrong, you'll see why and can answer again.\n:::\n\n# $unit.headline"
          },
          {
            "type": "question",
            "name": "topic",
            "variable": {
              "type": "nominal",
              "question": "What is this headline mainly about?",
              "options": [
                {
                  "value": "politics",
                  "label": "Politics"
                },
                {
                  "value": "economy",
                  "label": "Economy"
                },
                {
                  "value": "crime",
                  "label": "Crime"
                },
                {
                  "value": "sports",
                  "label": "Sports"
                },
                {
                  "value": "culture",
                  "label": "Culture"
                },
                {
                  "value": "other",
                  "label": "Other"
                }
              ]
            },
            "instruction": "- **Politics**: governments, councils, parties, elections, laws and public budgets.\n- **Economy**: companies, jobs, prices and incomes.\n- **Crime**: crimes, the police and the courts.\n- **Sports**: matches, clubs and athletes.\n- **Culture**: art, music, theatre, film and museums.\n- **Other**: anything else, such as the weather.\n\nChoose what the headline is *mainly* about.",
            "instructionOpen": "practice"
          },
          {
            "type": "question",
            "name": "clickbait",
            "variable": {
              "type": "swipe",
              "question": "Is this headline clickbait?",
              "options": [
                {
                  "value": "no",
                  "label": "No",
                  "color": "seagreen"
                },
                {
                  "value": "yes",
                  "label": "Clickbait",
                  "color": "darkorange"
                }
              ]
            },
            "instruction": "Clickbait teases instead of telling: it holds back what happened ('will surprise you', 'nine things you need to know') to make you click. Swipe left for no, right for clickbait."
          }
        ]
      },
      {
        "type": "question",
        "name": "difficulty",
        "variable": {
          "type": "ordinal",
          "question": "How hard was it to sort the headlines?",
          "options": [
            {
              "value": 1,
              "label": "Very easy"
            },
            {
              "value": 2,
              "label": "Easy"
            },
            {
              "value": 3,
              "label": "Hard"
            },
            {
              "value": 4,
              "label": "Very hard"
            }
          ]
        }
      },
      {
        "type": "question",
        "name": "practice_helped",
        "variable": {
          "type": "nominal",
          "question": "Did the practice headlines help you understand the task?",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "somewhat",
              "label": "Somewhat"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        }
      }
    ]
  },
