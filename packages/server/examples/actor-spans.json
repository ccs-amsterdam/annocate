{
  "category": "Simple annotation",
  "title": "Labeling actors in texts",
  "description": "Coders select the people and organisations in short news texts and label them: span annotation. With example answers from 2 coders, one of whom missed a few actors.",
  "tryThis": [
    "Open the invitation link in a private window and select words in the text to label them.",
    "Download the results: the spans come with their text, and with their positions in the _json columns."
  ],
  "name": "Labeling actors",
  "publish": true,
  "units": [
    {
      "id": "text-1",
      "data": {
        "text": "Mayor Anna de Wit met the board of the Harbour Company on Monday to discuss the new cruise terminal."
      }
    },
    {
      "id": "text-2",
      "data": {
        "text": "The Green Party criticised Minister Jan Peters for cutting the budget of the National Library."
      }
    },
    {
      "id": "text-3",
      "data": {
        "text": "According to the Weather Office, the storm will reach the coast on Friday, police chief Sara Bos said."
      }
    },
    {
      "id": "text-4",
      "data": {
        "text": "Union leader Mohammed Amrani called on Riverside Steel to keep the factory open."
      }
    },
    {
      "id": "text-5",
      "data": {
        "text": "Professor Lisa Chen of Northbridge University presented the report to the City Council."
      }
    },
    {
      "id": "text-6",
      "data": {
        "text": "The football club FC Westport signed striker Tom Visser for three years."
      }
    }
  ],
  "codebook": {
    "note": "Example: labeling actors",
    "items": [
      {
        "type": "unit_loop",
        "label": "Texts",
        "units": [
          {
            "mode": "all",
            "unitset": "__all__"
          }
        ],
        "layout": {
          "template": "$unit.text"
        },
        "children": [
          {
            "type": "question",
            "name": "actors",
            "variable": {
              "type": "span",
              "question": "Select every person and organisation mentioned in the text.",
              "instruction": "Select the words with your mouse (or finger), then choose a label. Click a label to change or remove it.",
              "fields": [
                "text"
              ],
              "options": [
                {
                  "value": "person",
                  "label": "Person",
                  "color": "#2563eb"
                },
                {
                  "value": "organisation",
                  "label": "Organisation",
                  "color": "#7c3aed"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "invites": [
    {
      "label": "Open link"
    }
  ],
  "answers": [
