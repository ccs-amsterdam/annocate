  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.6.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "miniflare": "^4.20260730.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^5.0.1"
  }
